#!/bin/bash
# Builds Kite and its tests before a push, so a compile error is caught in
# seconds locally instead of minutes later in CI. Incremental, so usually fast.
# Enable once per clone (covers its worktrees): git config core.hooksPath .githooks
# Skip for one push: git push --no-verify
set -euo pipefail

command -v swift >/dev/null || exit 0 # no toolchain here (e.g. a cloud container)

zero=0000000000000000000000000000000000000000
needs_build=0
while read -r _ local_sha _ remote_sha; do
  [[ $local_sha == "$zero" ]] && continue # branch delete
  if [[ $remote_sha == "$zero" ]]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  if [[ -z $base ]] || git diff --name-only "$base" "$local_sha" | grep -qE '\.(swift|h|mm?|cc|cpp|metal)$|^Package\.(swift|resolved)$'; then
    needs_build=1
  fi
done
[[ $needs_build == 1 ]] || exit 0

cd "$(git rev-parse --show-toplevel)"
echo "pre-push: swift build --build-tests (skip with --no-verify)" >&2
if ! swift build --build-tests >/tmp/kite-pre-push.log 2>&1; then
  grep -E 'error:' /tmp/kite-pre-push.log | head -20 >&2 || tail -20 /tmp/kite-pre-push.log >&2
  echo "pre-push: build failed, push stopped. Full log: /tmp/kite-pre-push.log" >&2
  exit 1
fi
