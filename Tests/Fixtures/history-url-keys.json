      "key": "https://a.example/caf%C3%A9?q=caf%C3%A9"
    },
    {
      "raw": "https://a.example/a|b?x=%41",
      "key": "https://a.example/a%7Cb?x=%41"
    },
    {
      "raw": "https://a.example/p%41?x=1#a b",
      "key": "https://a.example/p%41?x=1#a%20b"
