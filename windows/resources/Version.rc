// Kite's version resource: the name Task Manager and Explorer show for Kite.exe and its
// Chromium processes. Built into Kite.dll, and copied from it into Kite.exe (CEF's bootstrap)
// by cmake/StampBootstrap.cpp; built into Kite.exe itself where there's no CEF.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Kite"
      VALUE "FileVersion", "0.1.0.0"
      VALUE "InternalName", "Kite"
      VALUE "OriginalFilename", "Kite.exe"
      VALUE "ProductName", "Kite"
      VALUE "ProductVersion", "0.1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
