# Drives kitecore against a fresh profile: ctest runs it with -DKITECORE=<path> -DWORK=<dir>.
# A script run with -P has no policy version of its own: without this line an older CMake runs it
# with CMP0054 OLD, and a quoted string in if() ("reload") reads a variable of that name.
cmake_minimum_required(VERSION 3.24)
# kitecore writes UTF-8 ("Rename Space…", emoji), so every execute_process that reads its output
# decodes it as UTF-8: without a policy saying so, CMake decodes it with the console's code page
# (437 on a default console), and the "…" checks miss.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(kitecore out)
  execute_process(COMMAND "${KITECORE}" --profile "${WORK}" ${ARGN}
                  RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr OUTPUT_STRIP_TRAILING_WHITESPACE ENCODING UTF8)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "kitecore ${ARGN} exited ${code}: ${stderr}")
  endif()
  set(${out} "${stdout}" PARENT_SCOPE)
endfunction()

function(expect_exit_early expected)
  execute_process(COMMAND "${KITECORE}" --profile "${WORK}" ${ARGN} RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "kitecore ${ARGN}: expected exit ${expected}, got ${code}")
  endif()
endfunction()

kitecore(url resolve apple.com)
if(NOT url STREQUAL "https://apple.com")
  message(FATAL_ERROR "resolve gave '${url}'")
endif()

kitecore(id open news.ycombinator.com/item?id=1)
kitecore(state state)
string(JSON selected GET "${state}" selectedTab id)
if(NOT selected STREQUAL id)
  message(FATAL_ERROR "opened tab ${id} isn't selected: ${state}")
endif()
string(JSON first GET "${state}" spaces 0 tabs 0 url)
if(NOT first STREQUAL "https://news.ycombinator.com/item?id=1")
