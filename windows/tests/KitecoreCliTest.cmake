# Another Chromium profile's Kite History.json, and never a path out of the profile.
kitecore(added history add https://work.example/ Work --chromium "Profile 2")
if(NOT EXISTS "${WORK}/Chromium/Profile 2/Kite History.json")
  message(FATAL_ERROR "--chromium didn't write Chromium/Profile 2/Kite History.json")
endif()
expect_exit_early(1 history list --chromium ..)
expect_exit_early(1 history list --chromium "a/b")
# An unreadable file is reported and left as it is; suggest goes on without it.
file(WRITE "${WORK}/Chromium/Profile 2/Kite History.json" "{ broken")
expect_exit_early(3 history list --chromium "Profile 2")
expect_exit_early(3 history add https://x.example/ --chromium "Profile 2")
file(READ "${WORK}/Chromium/Profile 2/Kite History.json" text)
if(NOT text STREQUAL "{ broken")
  message(FATAL_ERROR "kitecore wrote over an unreadable history: ${text}")
