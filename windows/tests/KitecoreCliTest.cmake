# Two fingers sideways over the sidebar: past half a page lands on the next space, past the last
# space the pages rubber-band and stay, a short slow drag stays, and back lands on the first.
function(expect_swipe dx seconds landing space)
  kitecore(swipe space swipe ${dx} ${seconds})
  string(JSON got GET "${swipe}" landing)
  string(JSON now GET "${swipe}" space)
  kitecore(state state)
  string(JSON current GET "${state}" selectedSpaceID)
  if(NOT got EQUAL landing OR NOT now STREQUAL space OR NOT current STREQUAL space)
    message(FATAL_ERROR "space swipe ${dx} ${seconds} gave ${swipe}, selected ${current}")
  endif()
  set(swipe "${swipe}" PARENT_SCOPE)
endfunction()
