# Import from Arc's merge, from a history.json: a page here keeps its later visit and higher count.
file(WRITE "${WORK}/import.json" "{\"history\":{\"entries\":{\"https://other.example/\":{\"lastVisit\":1,\"title\":\"Old\",\"url\":\"https://other.example/\",\"visitCount\":7},\"https://new.example/a|b\":{\"lastVisit\":784000300,\"title\":\"New\",\"url\":\"https://new.example/a|b\",\"visitCount\":2}}},\"version\":1}")
kitecore(merged history merge "${WORK}/import.json")
string(JSON added GET "${merged}" added)
if(NOT added EQUAL 1)
  message(FATAL_ERROR "history merge gave ${merged}")
endif()
kitecore(found history search other)
string(JSON visits GET "${found}" 0 visitCount)
string(JSON title GET "${found}" 0 title)
if(NOT visits EQUAL 7 OR NOT title STREQUAL "Other")
  message(FATAL_ERROR "a merged page that was here: ${found}")
endif()
# Kept as the Mac's NSURL keeps it.
kitecore(found history search new.example)
string(JSON url GET "${found}" 0 url)
if(NOT url STREQUAL "https://new.example/a%7Cb")
  message(FATAL_ERROR "the merged URL isn't the Mac's form: ${found}")
endif()
kitecore(removed history remove "https://new.example/a|b")
string(JSON removed GET "${removed}" removed)
if(NOT removed EQUAL 1)
  message(FATAL_ERROR "history remove gave ${removed}")
endif()
kitecore(removed history remove-since 784000150)
string(JSON removed GET "${removed}" removed)
kitecore(listed history list)
string(JSON count LENGTH "${listed}")
if(NOT removed EQUAL 1 OR NOT count EQUAL 1)
  message(FATAL_ERROR "history remove-since left ${listed}")
endif()
# 2001-01-01 in Chromium's microseconds since 1601 is Foundation's 0.
kitecore(date history chromium-date 12622780800000000)
if(NOT date STREQUAL "0")
  message(FATAL_ERROR "history chromium-date gave ${date}")
endif()
kitecore(cleared history clear)
kitecore(listed history list)
if(NOT listed STREQUAL "[]")
  message(FATAL_ERROR "history clear left ${listed}")
endif()

# A bad or missing --profile never falls back to the real profile (here a stand-in LOCALAPPDATA).
set(real "${WORK}/real-local-app-data")
file(MAKE_DIRECTORY "${real}")
function(expect_exit expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=KITE_SUPPORT_PATH "LOCALAPPDATA=${real}" "${KITECORE}" ${ARGN}
                  RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "kitecore ${ARGN}: expected exit ${expected}, got ${code}")
  endif()
endfunction()
expect_exit(2 --profile "" open evil.example)
expect_exit(1 open evil.example --profile)
expect_exit(2 open evil.example --profile "${WORK}/missing")
set(second "${WORK}/second")
file(MAKE_DIRECTORY "${second}")
expect_exit(0 open trailing.example --profile "${second}")
# ...and without one it benches in a temp folder of its own, never the real profile.
expect_exit(0 save-bench 3)
if(EXISTS "${real}/Kite")
  message(FATAL_ERROR "kitecore wrote to the real profile")
endif()
file(READ "${second}/session.json" text)
if(NOT text MATCHES "https://trailing.example\"")
  message(FATAL_ERROR "--profile after the command wasn't used: ${text}")
endif()

# Import from Arc: --auto finds the hand-made Arc for Windows folder (tests/fixtures/arc-windows)
# where Arc's package keeps it under LOCALAPPDATA, and prints what came over per kind.
set(arc "${WORK}/arc")
file(MAKE_DIRECTORY "${arc}")
function(import_arc out)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=KITE_SUPPORT_PATH --unset=KITE_ARC_DATA_PATH "LOCALAPPDATA=${ARC_LOCAL_APP_DATA}"
                          "${KITECORE}" --profile "${arc}" import-arc ${ARGN}
                  RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "kitecore import-arc ${ARGN} exited ${code}: ${stderr}")
  endif()
  set(${out} "${stdout}" PARENT_SCOPE)
endfunction()
import_arc(summary --auto)
foreach(pair "spaces=1" "pinnedTabs=4" "tabs=2" "folders=1" "splits=1" "favorites=1" "archivedTabs=2" "siteSearches=6"
             "keyBindings=2" "routes=1" "historyPages=86" "historyPagesNew=86")
  string(REPLACE "=" ";" kv "${pair}")
  list(GET kv 0 key)
  list(GET kv 1 expected)
  string(JSON got GET "${summary}" imported ${key})
  if(NOT got EQUAL expected)
    message(FATAL_ERROR "import-arc imported ${got} ${key}, not ${expected}: ${summary}")
  endif()
endforeach()
string(JSON skipped0 GET "${summary}" skipped 0 kind)
if(NOT skipped0 STREQUAL "unnamedSpaces")
  message(FATAL_ERROR "import-arc didn't report the unnamed space it left out: ${summary}")
endif()
foreach(file session.json keybindings.json LinkRouting.json history.json)
  if(NOT EXISTS "${arc}/${file}")
    message(FATAL_ERROR "import-arc wrote no ${file}")
  endif()
endforeach()
# Arc's history (W33a): Default's History, read as the Mac's query reads it, is in history.json,
# and what was left out is counted by reason. Profile 1's stays out with its unnamed space.
string(JSON found GET "${summary}" found historyRows)
if(NOT found EQUAL 92)
  message(FATAL_ERROR "import-arc found ${found} history rows, not 92: ${summary}")
endif()
foreach(pair "historyHidden=1" "historyNeverVisited=1" "historyNotWebPages=2" "historyProfilesLeftOut=2")
  string(REPLACE "=" ";" kv "${pair}")
  list(GET kv 0 key)
  list(GET kv 1 expected)
  string(JSON count LENGTH "${summary}" skipped)
  math(EXPR last "${count} - 1")
  set(got "")
  foreach(i RANGE ${last})
    string(JSON kind GET "${summary}" skipped ${i} kind)
    if(kind STREQUAL key)
      string(JSON got GET "${summary}" skipped ${i} count)
    endif()
  endforeach()
  if(NOT got EQUAL expected)
    message(FATAL_ERROR "import-arc skipped ${got} ${key}, not ${expected}: ${summary}")
  endif()
endforeach()
execute_process(COMMAND "${KITECORE}" --profile "${arc}" history list OUTPUT_VARIABLE pages)
string(JSON pageCount LENGTH "${pages}")
string(JSON newest GET "${pages}" 0 url)
if(NOT pageCount EQUAL 86 OR NOT newest STREQUAL "https://docs.kite.example/start")
  message(FATAL_ERROR "history after import-arc: ${pageCount} pages, newest ${newest}")
endif()
execute_process(COMMAND "${KITECORE}" --profile "${arc}" state OUTPUT_VARIABLE state)
string(JSON name GET "${state}" spaces 2 name)
if(NOT name STREQUAL "Reading")
  message(FATAL_ERROR "the imported space isn't in the session: ${state}")
endif()
# Again with the unnamed space, from the folder itself: the same space is replaced, not added.
import_arc(summary "${ARC_LOCAL_APP_DATA}/Packages/TheBrowserCompany.Arc_kitetest0001/LocalCache/Local" --include-unnamed)
string(JSON added GET "${summary}" imported spacesAdded)
string(JSON updated GET "${summary}" imported spacesUpdated)
string(JSON made LENGTH "${summary}" imported newProfiles)
string(JSON again GET "${summary}" imported historyPagesNew)
if(NOT added EQUAL 1 OR NOT updated EQUAL 1 OR NOT made EQUAL 1 OR NOT again EQUAL 2)
  message(FATAL_ERROR "import-arc --include-unnamed: ${summary}")
endif()
# A file that isn't Arc's sidebar is refused, and nothing is written.
file(WRITE "${WORK}/notes.json" "{}")
file(READ "${arc}/session.json" before)
execute_process(COMMAND "${KITECORE}" --profile "${arc}" import-arc "${WORK}/notes.json" RESULT_VARIABLE code OUTPUT_QUIET ERROR_VARIABLE stderr)
file(READ "${arc}/session.json" after)
if(NOT code EQUAL 5 OR NOT stderr MATCHES "notes.json isn't Arc's sidebar" OR NOT before STREQUAL after)
  message(FATAL_ERROR "import-arc of another file: exit ${code}, ${stderr}")
endif()
# Arc's profile came over as a Kite profile: `profile` lists, renames and (once no space uses
# it) deletes it, and Default can't go.
execute_process(COMMAND "${KITECORE}" --profile "${arc}" profile list OUTPUT_VARIABLE profiles)
string(JSON made GET "${profiles}" 1 directory)
string(JSON name GET "${profiles}" 1 name)
if(NOT name STREQUAL "Side Project")
  message(FATAL_ERROR "profile list: ${profiles}")
endif()
execute_process(COMMAND "${KITECORE}" --profile "${arc}" profile rename "${made}" "Side Gig" RESULT_VARIABLE code)
execute_process(COMMAND "${KITECORE}" --profile "${arc}" profile delete "${made}" RESULT_VARIABLE inUse)
execute_process(COMMAND "${KITECORE}" --profile "${arc}" profile delete Default RESULT_VARIABLE default)
execute_process(COMMAND "${KITECORE}" --profile "${arc}" profile add "side gig" RESULT_VARIABLE duplicate ERROR_QUIET)
execute_process(COMMAND "${KITECORE}" --profile "${arc}" profile list OUTPUT_VARIABLE profiles)
string(JSON name GET "${profiles}" 1 name)
if(NOT code EQUAL 0 OR NOT inUse EQUAL 5 OR NOT default EQUAL 5 OR NOT duplicate EQUAL 1 OR NOT name STREQUAL "Side Gig")
  message(FATAL_ERROR "profile: rename ${code}, delete in use ${inUse}, delete Default ${default}, duplicate ${duplicate}: ${profiles}")
endif()
# --leave-out-unnamed on a fresh profile: the unnamed space stays out, and the summary says so.
set(fresh "${WORK}/arc-fresh")
file(MAKE_DIRECTORY "${fresh}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=KITE_SUPPORT_PATH --unset=KITE_ARC_DATA_PATH "LOCALAPPDATA=${ARC_LOCAL_APP_DATA}"
                        "${KITECORE}" --profile "${fresh}" import-arc --leave-out-unnamed OUTPUT_VARIABLE summary RESULT_VARIABLE code)
string(JSON unnamed GET "${summary}" imported unnamedSpaces)
if(NOT code EQUAL 0 OR NOT unnamed EQUAL 0)
  message(FATAL_ERROR "import-arc --leave-out-unnamed: ${summary}")
endif()
file(REMOVE_RECURSE "${WORK}")
