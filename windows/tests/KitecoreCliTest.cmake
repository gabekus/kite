# Drives kitecore against a fresh profile: ctest runs it with -DKITECORE=<path> -DWORK=<dir>.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(kitecore out)
  execute_process(COMMAND "${KITECORE}" --profile "${WORK}" ${ARGN}
                  RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "kitecore ${ARGN} exited ${code}: ${stderr}")
  endif()
  set(${out} "${stdout}" PARENT_SCOPE)
endfunction()

kitecore(url resolve apple.com)
if(NOT url STREQUAL "https://apple.com")
  message(FATAL_ERROR "resolve gave '${url}'")
endif()

kitecore(id open news.ycombinator.com/item?id=1)
kitecore(state state)
string(JSON selected GET "${state}" selectedTab id)
if(NOT selected STREQUAL id)
  message(FATAL_ERROR "opened tab ${id} isn't selected: ${state}")
endif()
string(JSON first GET "${state}" spaces 0 tabs 0 url)
if(NOT first STREQUAL "https://news.ycombinator.com/item?id=1")
  message(FATAL_ERROR "new tab isn't on top: ${state}")
endif()

kitecore(ignored space next)
kitecore(state state)
string(JSON work GET "${state}" spaces 1 id)
string(JSON current GET "${state}" selectedSpaceID)
if(NOT current STREQUAL work)
  message(FATAL_ERROR "space next didn't select Work: ${state}")
endif()

kitecore(theme theme "${work}")
string(JSON accent GET "${theme}" accent)
string(JSON glowCount LENGTH "${theme}" glow)
if(NOT accent MATCHES "^#[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]$" OR NOT glowCount EQUAL 2)
  message(FATAL_ERROR "theme gave ${theme}")
endif()
# The backdrop sits on the light material when the theme wants dark text, else the dark one,
# and isn't one flat colour (the default Work theme is three colours).
string(JSON material GET "${theme}" backdrop material)
string(JSON darkText GET "${theme}" prefersDarkForeground)
string(JSON topLeft GET "${theme}" backdrop topLeft)
string(JSON bottomRight GET "${theme}" backdrop bottomRight)
if(darkText)
  set(expectedMaterial "#F3F3F3")
else()
  set(expectedMaterial "#202020")
endif()
if(NOT material STREQUAL expectedMaterial OR NOT topLeft MATCHES "^#[0-9A-F]+$" OR topLeft STREQUAL bottomRight)
  message(FATAL_ERROR "theme backdrop gave ${theme}")
endif()

if(NOT EXISTS "${WORK}/session.json")
  message(FATAL_ERROR "no session.json written")
endif()

# A bad or missing --profile never falls back to the real profile (here a stand-in LOCALAPPDATA).
set(real "${WORK}/real-local-app-data")
file(MAKE_DIRECTORY "${real}")
function(expect_exit expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=KITE_SUPPORT_PATH "LOCALAPPDATA=${real}" "${KITECORE}" ${ARGN}
                  RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "kitecore ${ARGN}: expected exit ${expected}, got ${code}")
  endif()
endfunction()
expect_exit(2 --profile "" open evil.example)
expect_exit(1 open evil.example --profile)
expect_exit(2 open evil.example --profile "${WORK}/missing")
set(second "${WORK}/second")
file(MAKE_DIRECTORY "${second}")
expect_exit(0 open trailing.example --profile "${second}")
if(EXISTS "${real}/Kite")
  message(FATAL_ERROR "kitecore wrote to the real profile")
endif()
file(READ "${second}/session.json" text)
if(NOT text MATCHES "https://trailing.example\"")
  message(FATAL_ERROR "--profile after the command wasn't used: ${text}")
endif()
file(REMOVE_RECURSE "${WORK}")
