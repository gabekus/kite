   OR NOT shows0 STREQUAL "emoji" OR NOT shows1 STREQUAL "symbol" OR NOT glyph1 STREQUAL "ON"
   OR NOT accent1 STREQUAL "#D74B86" OR NOT headerShows STREQUAL "emoji")
  message(FATAL_ERROR "the space bar gave ${bar}")
