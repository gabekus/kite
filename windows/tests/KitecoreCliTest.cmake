string(JSON fourthLeft GET "${bar}" favorites tiles 3 left)
string(JSON fourthTop GET "${bar}" favorites tiles 3 top)
if(NOT columns EQUAL 3 OR NOT trayHeight EQUAL 118 OR NOT listTop EQUAL 200 OR NOT tiles EQUAL 6 OR NOT youtube STREQUAL "YouTube"
   OR NOT youtubeSelected OR hnSelected OR NOT youtubeFill MATCHES "^0[.]4(5|49999)" OR NOT hnFill MATCHES "^0[.]1(0*|00000*1.*)$"
