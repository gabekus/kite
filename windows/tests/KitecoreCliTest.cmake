# A bad or missing --profile never falls back to the real profile (here a stand-in LOCALAPPDATA).
set(real "${WORK}/real-local-app-data")
file(MAKE_DIRECTORY "${real}")
function(expect_exit expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=KITE_SUPPORT_PATH "LOCALAPPDATA=${real}" "${KITECORE}" ${ARGN}
                  RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "kitecore ${ARGN}: expected exit ${expected}, got ${code}")
  endif()
endfunction()
