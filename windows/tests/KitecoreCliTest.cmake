string(JSON youtubeSelected GET "${bar}" favorites tiles 0 panes 0 selected)
string(JSON youtubeFill GET "${bar}" favorites tiles 0 panes 0 fill)
string(JSON hnSelected GET "${bar}" favorites tiles 1 panes 0 selected)
string(JSON hnFill GET "${bar}" favorites tiles 1 panes 0 fill)
string(JSON hnID GET "${bar}" favorites tiles 1 panes 0 id)
