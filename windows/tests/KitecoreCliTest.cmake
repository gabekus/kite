# Import from Arc's merge, from a history.json: a page here keeps its later visit and higher count.
file(WRITE "${WORK}/import.json" "{\"history\":{\"entries\":{\"https://other.example/\":{\"lastVisit\":1,\"title\":\"Old\",\"url\":\"https://other.example/\",\"visitCount\":7},\"https://new.example/a|b\":{\"lastVisit\":784000300,\"title\":\"New\",\"url\":\"https://new.example/a|b\",\"visitCount\":2}}},\"version\":1}")
kitecore(merged history merge "${WORK}/import.json")
string(JSON added GET "${merged}" added)
