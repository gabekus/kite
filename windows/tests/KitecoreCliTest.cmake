  message(FATAL_ERROR "space drag gave ${drag}, then ${state}")
endif()
# Dropped over the + button (off the strip): back where it was.
kitecore(drag space drag "${reading}" 220)
string(JSON landing GET "${drag}" landing)
if(NOT landing EQUAL 0)
  message(FATAL_ERROR "a drag dropped off the strip gave ${drag}")
endif()
kitecore(place space move "${reading}" 3)
kitecore(folder space folder "${work}")
if(NOT place EQUAL 3 OR NOT folder MATCHES "^[0-9A-F-]+$")
  message(FATAL_ERROR "space move gave ${place}, space folder ${folder}")
endif()
# An empty space deletes at once; the one before it is selected.
kitecore(deleted space delete "${reading}")
string(JSON kind GET "${deleted}" kind)
string(JSON current GET "${deleted}" selected)
kitecore(state state)
string(JSON count LENGTH "${state}" spaces)
if(NOT kind STREQUAL "now" OR NOT current STREQUAL work OR NOT count EQUAL 2)
  message(FATAL_ERROR "space delete gave ${deleted}, then ${state}")
endif()
expect_exit_early(5 space delete 00000000-0000-0000-0000-000000000000)
# The last space stays: refused, with its own exit code.
set(lone "${WORK}/lone")
file(MAKE_DIRECTORY "${lone}")
execute_process(COMMAND "${KITECORE}" --profile "${lone}" space add Only OUTPUT_VARIABLE onlyID OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE code ENCODING UTF8)
execute_process(COMMAND "${KITECORE}" --profile "${lone}" state OUTPUT_VARIABLE loneState ENCODING UTF8)
string(JSON loneCount LENGTH "${loneState}" spaces)
foreach(i RANGE 1 ${loneCount})
  string(JSON first GET "${loneState}" spaces 0 id)
  execute_process(COMMAND "${KITECORE}" --profile "${lone}" space delete "${first}" RESULT_VARIABLE code OUTPUT_QUIET)
  execute_process(COMMAND "${KITECORE}" --profile "${lone}" state OUTPUT_VARIABLE loneState ENCODING UTF8)
endforeach()
string(JSON loneCount LENGTH "${loneState}" spaces)
if(NOT code EQUAL 6 OR NOT loneCount EQUAL 1)
  message(FATAL_ERROR "deleting the last space: expected exit 6 with one space left, got ${code} and ${loneState}")
endif()
expect_exit_early(1 space new "   ")
expect_exit_early(1 space move "${work}" 0)

kitecore(theme theme "${work}")
string(JSON accent GET "${theme}" accent)
string(JSON glowCount LENGTH "${theme}" glow)
if(NOT accent MATCHES "^#[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]$" OR NOT glowCount EQUAL 2)
  message(FATAL_ERROR "theme gave ${theme}")
endif()
# The backdrop sits on the light material when the theme wants dark text, else the dark one,
# and isn't one flat colour (the default Work theme is three colours).
string(JSON material GET "${theme}" backdrop material)
string(JSON darkText GET "${theme}" prefersDarkForeground)
string(JSON topLeft GET "${theme}" backdrop topLeft)
string(JSON bottomRight GET "${theme}" backdrop bottomRight)
if(darkText)
  set(expectedMaterial "#F3F3F3")
else()
  set(expectedMaterial "#202020")
endif()
if(NOT material STREQUAL expectedMaterial OR NOT topLeft MATCHES "^#[0-9A-F]+$" OR topLeft STREQUAL bottomRight)
  message(FATAL_ERROR "theme backdrop gave ${theme}")
endif()
function(expect_exit_on_work_profile expected)
  execute_process(COMMAND "${KITECORE}" --profile "${WORK}" ${ARGN} RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "kitecore ${ARGN}: expected exit ${expected}, got ${code}")
  endif()
endfunction()
kitecore(theme2x theme "${work}" 2560 1640)
string(JSON size0 GET "${theme2x}" backdrop size 0)
string(JSON topLeft2x GET "${theme2x}" backdrop topLeft)
if(NOT size0 EQUAL 2560 OR NOT topLeft2x MATCHES "^#[0-9A-F]+$")
  message(FATAL_ERROR "theme at 2560x1640 gave ${theme2x}")
endif()
expect_exit_on_work_profile(1 theme "${work}" 0 820)

if(NOT EXISTS "${WORK}/session.json")
  message(FATAL_ERROR "no session.json written")
endif()

# W11: the save timer replayed headless. A ticking title waits ten seconds and is never pushed
# back; a sidebar change brings the save forward to a second after it.
kitecore(saves save-schedule soon@0 pageEvent@0.5 pageEvent@3 soon@4 pageEvent@20)
if(NOT saves STREQUAL [=[{"saves":[{"at":1,"kind":"soon"},{"at":5,"kind":"soon"},{"at":30,"kind":"pageEvent"}]}]=])
  message(FATAL_ERROR "save-schedule gave ${saves}")
endif()
kitecore(waiting save-schedule pageEvent@0 pageEvent@4 --at 5)
if(NOT waiting STREQUAL [=[{"dueAt":10,"pending":"pageEvent","saves":[]}]=])
  message(FATAL_ERROR "save-schedule --at gave ${waiting}")
endif()
expect_exit_early(1 save-schedule later@1)
expect_exit_early(1 save-schedule soon@2 soon@1)
# save-bench never touches a profile: given one, it refuses.
expect_exit_early(1 save-bench 3)
# kitecore's own saves make no backups (the app's writer keeps them); a backup put there is
# listed with what it holds, newest first, and so is one that doesn't read.
kitecore(listed backups)
string(JSON count LENGTH "${listed}" backups)
if(NOT count EQUAL 0)
  message(FATAL_ERROR "kitecore's saves made backups: ${listed}")
endif()
file(MAKE_DIRECTORY "${WORK}/Backups")
file(COPY_FILE "${WORK}/session.json" "${WORK}/Backups/session.2023-11-14-22-13-20-000.launch.json")
file(WRITE "${WORK}/Backups/session.2023-11-14-23-13-20-000.json" "{nope")
kitecore(listed backups)
string(JSON count LENGTH "${listed}" backups)
string(JSON first GET "${listed}" backups 0 file)
string(JSON firstRestorable GET "${listed}" backups 0 restorable)
string(JSON kind1 GET "${listed}" backups 1 kind)
string(JSON spaces1 GET "${listed}" backups 1 spaces)
if(NOT count EQUAL 2 OR NOT first STREQUAL "session.2023-11-14-23-13-20-000.json" OR firstRestorable OR NOT kind1 STREQUAL "launch" OR spaces1 LESS 1)
  message(FATAL_ERROR "backups gave ${listed}")
endif()
# Backups are listed even when session.json doesn't read.
file(COPY_FILE "${WORK}/session.json" "${WORK}/session.good")
file(WRITE "${WORK}/session.json" "{nope")
kitecore(listed backups)
file(RENAME "${WORK}/session.good" "${WORK}/session.json")
file(REMOVE_RECURSE "${WORK}/Backups")

# History (W25a): history.json in the Mac's format, the command bar's search, and its rows.
kitecore(added history add https://www.recipes.example/pasta Pasta Carbonara --at 784000000)
string(JSON visits GET "${added}" visitCount)
string(JSON title GET "${added}" title)
if(NOT visits EQUAL 1 OR NOT title STREQUAL "Pasta Carbonara")
  message(FATAL_ERROR "history add gave ${added}")
endif()
kitecore(added history add https://www.recipes.example/pasta --at 784000100)
string(JSON visits GET "${added}" visitCount)
string(JSON title GET "${added}" title)
if(NOT visits EQUAL 2 OR NOT title STREQUAL "Pasta Carbonara")
  message(FATAL_ERROR "a second visit with no title gave ${added}")
endif()
kitecore(added history add https://other.example/ Other --at 784000200)
expect_exit_early(5 history add about:blank)
file(READ "${WORK}/history.json" text)
if(NOT text MATCHES "^\\{\"history\":\\{\"entries\":\\{\"https://other.example/\":\\{\"lastVisit\":784000200,\"title\":\"Other\"")
  message(FATAL_ERROR "history.json isn't the Mac's shape: ${text}")
endif()
kitecore(listed history list)
string(JSON first GET "${listed}" 0 url)
string(JSON count LENGTH "${listed}")
if(NOT count EQUAL 2 OR NOT first STREQUAL "https://other.example/")
  message(FATAL_ERROR "history list isn't newest first: ${listed}")
endif()
kitecore(found history search recipes)
string(JSON count LENGTH "${found}")
string(JSON url GET "${found}" 0 url)
if(NOT count EQUAL 1 OR NOT url STREQUAL "https://www.recipes.example/pasta")
  message(FATAL_ERROR "history search gave ${found}")
endif()
# The bar: the search, then the page from history, its host and path after its title.
kitecore(rows suggest carbonara)
string(JSON kind1 GET "${rows}" 1 kind)
string(JSON subtitle1 GET "${rows}" 1 subtitle)
