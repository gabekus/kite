+namespace {
+
+// GetNavigationState's format: version, selected index, entry count, then each
+// entry as Chrome's session restore pickles it.
+constexpr int kNavigationStateVersion = 1;
+// Per entry. An entry over it is written without its page state, as in
+// Chrome's session restore.
+constexpr int kMaxNavigationEntrySize = 1024 * 1024;
+
+}  // namespace
+
+CefRefPtr<CefBinaryValue> CefBrowserHostBase::GetNavigationState() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return nullptr;
+  }
+
+  auto web_contents = GetWebContents();
+  if (!web_contents) {
+    return nullptr;
+  }
+
+  content::NavigationController& controller = web_contents->GetController();
+  content::NavigationEntry* committed = controller.GetLastCommittedEntry();
+  if (!committed || committed->IsInitialEntry()) {
+    return nullptr;
+  }
+
+  const int count = controller.GetEntryCount();
+  base::Pickle pickle;
+  pickle.WriteInt(kNavigationStateVersion);
+  pickle.WriteInt(controller.GetLastCommittedEntryIndex());
+  pickle.WriteInt(count);
+  for (int i = 0; i < count; ++i) {
+    sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+        i, controller.GetEntryAtIndex(i))
+        .WriteToPickle(kMaxNavigationEntrySize, &pickle);
+  }
+  return CefBinaryValue::Create(pickle.data(), pickle.size());
+}
+
+bool CefBrowserHostBase::RestoreNavigationState(
+    CefRefPtr<CefBinaryValue> state) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+
+  auto web_contents = GetWebContents();
+  if (!web_contents || !state || state->GetSize() == 0) {
+    return false;
+  }
+
+  auto iterator = base::PickleIterator::WithData(
+      base::span(static_cast<const uint8_t*>(state->GetRawData()),
+                 state->GetSize()));
+  int version = 0, selected = 0, count = 0;
+  if (!iterator.ReadInt(&version) || version != kNavigationStateVersion ||
+      !iterator.ReadInt(&selected) || !iterator.ReadInt(&count) ||
+      count <= 0 || selected < 0 || selected >= count) {
+    return false;
+  }
+
+  std::vector<sessions::SerializedNavigationEntry> navigations(count);
+  for (auto& navigation : navigations) {
+    if (!navigation.ReadFromPickle(&iterator)) {
+      return false;
+    }
+  }
+
+  auto entries = sessions::ContentSerializedNavigationBuilder::
+      ToNavigationEntries(navigations, web_contents->GetBrowserContext());
+  content::NavigationController& controller = web_contents->GetController();
+  controller.Restore(selected, content::RestoreType::kRestored, &entries);
+  controller.LoadIfNecessary();
+  return true;
+}
